{
  "name": "cellsweb-rpc-monorepo",
  "private": true,
  "description": "CellsWeb RPC API Monorepo — ultra-performant RPC framework with O(1) routing, runtime TypeBox validation, and universal client",
  "keywords": [
    "rpc",
    "api",
    "node",
    "typescript",
    "typebox"
  ],
  "author": "Minhazur Rahman",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --filter=!example run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "publish:all": "pnpm -r publish --access public --no-git-checks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CellsWeb/crpc-node.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.10.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
