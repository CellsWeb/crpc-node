{
  "name": "@cellsweb/rpc-core",
  "version": "1.0.33",
  "publishConfig": {
    "access": "public"
  },
  "description": "Core runtime engine for CellsWeb RPC API — O(1) dispatch, TypeBox schemas, Busboy multipart parser, and interactive docs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crpc": "./bin/crpc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rpc",
    "typebox",
    "busboy",
    "cellsweb",
    "api"
  ],
  "author": "Minhazur Rahman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CellsWeb/crpc-node.git"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sinclair/typebox": "^0.34.52",
    "busboy": "^1.6.0",
    "mime-types": "^3.0.2",
    "pino": "^10.3.1",
    "safe-stable-stringify": "^2.5.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
