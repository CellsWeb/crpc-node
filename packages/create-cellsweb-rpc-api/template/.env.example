NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_REQUEST_TIMEOUT_MS=30000
API_LOG_LEVEL=info

MAX_JSON_BODY_BYTES=1048576
MAX_MULTIPART_BYTES=25000000
MAX_UPLOAD_FILE_BYTES=10000000
# UPLOAD_TMP_DIR=

UPLOAD_MODE=local
UPLOAD_DIR=public/uploads
SERVER_URL=http://localhost:4000

# S3 Upload Mode Credentials (Optional - required only when UPLOAD_MODE=s3)
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://7257918ddeec82e2108839bda87bbfe6.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev  (or custom CDN domain https://cdn.example.com)

# Optional Sentry & Telemetry (Only initialized if SENTRY_DSN is provided)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
TELEMETRY_ENABLED=true

# Test Database & Security Audit Configuration
# TEST_DB_TYPE options: "memory" (fast in-RAM) or "real" (staging/remote DB)
TEST_DB_TYPE=memory
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/cellsweb_test
JWT_SECRET=super-secret-jwt-key-for-auth-and-test-actors

