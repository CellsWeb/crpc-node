{
  "name": "@cellsweb/rpc-client",
  "version": "1.0.23",
  "publishConfig": {
    "access": "public"
  },
  "description": "Client SDK & React / React Native hooks for CellsWeb RPC API — universal fetch, automatic multipart form-data, and provider context",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rpc",
    "cellsweb",
    "client",
    "react",
    "react-native",
    "hooks",
    "fetch",
    "multipart"
  ],
  "author": "Minhazur Rahman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CellsWeb/crpc-node.git"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.8",
    "react": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
