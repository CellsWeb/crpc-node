NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_REQUEST_TIMEOUT_MS=30000
API_LOG_LEVEL=info

MAX_JSON_BODY_BYTES=1048576
MAX_MULTIPART_BYTES=25000000
MAX_UPLOAD_FILE_BYTES=10000000
# UPLOAD_TMP_DIR=

UPLOAD_MODE=local
UPLOAD_DIR=public/uploads
SERVER_URL=http://localhost:4000

# S3 Upload Mode Credentials (Optional - required only when UPLOAD_MODE=s3)
# S3_BUCKET=my-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# Optional Sentry & Telemetry (Only initialized if SENTRY_DSN is provided)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
TELEMETRY_ENABLED=true
